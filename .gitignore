# secrets - never commit
.env
.streamlit/secrets.toml

# The index IS shipped, so a deployed app has something to search: catalog.db
# (source text the verifier checks against), vectors.npz (embeddings) and
# manifest.json are tracked. Only the derivable parts are ignored:
#   figures/  ~70 MB of PNGs that are re-cropped from the PDFs on demand
#   chroma/   the old vector store, replaced by vectors.npz
# Leading slashes matter - unanchored "index/" would also exclude the
# nrc_rag/index source package.
/index/figures/
/index/chroma/
/index/figure_descriptions_cache.json
/index/*.tmp

# the query audit trail is local runtime data
/audit/
/index_test_tmp/
*.log

# python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
build/
dist/
*.egg-info/
.venv/
venv/

# OS / editors / Google Drive artifacts
desktop.ini
Thumbs.db
.DS_Store
~$*
.vscode/
.idea/

# v1 prototype originals in the project root still contain hard-coded keys.
# Redacted copies are tracked in legacy/ instead.
/01_query.py
/02_dashboard.py
/Flow diags.txt
