# Copy to .env and fill in what you use. .env is git-ignored.

# Provider selection: auto = first configured key in the order anthropic > openai > google
NRC_LLM_PROVIDER=auto

# --- Anthropic Claude (recommended: the API returns verbatim cited spans) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# low | medium | high | xhigh | max  (reasoning effort)
ANTHROPIC_EFFORT=high
# Opt-in server-side refusal fallbacks (off by default so the audit trail always names one model)
ANTHROPIC_ENABLE_FALLBACKS=false

# --- OpenAI-compatible chat completions (OpenAI, Core42, Azure gateway, vLLM, Ollama) ---
OPENAI_API_KEY=
# Leave empty for api.openai.com. Core42: https://api.core42.ai/v1   Ollama: http://localhost:11434/v1
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o

# --- Google Gemini ---
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.5-pro

# --- Paths (default: Data/, index/, audit/ inside the project) ---
# NRC_DATA_DIR=Data
# NRC_INDEX_DIR=index
# NRC_AUDIT_DIR=audit

# --- Retrieval / verification tuning (defaults shown) ---
# NRC_EMBEDDING_MODEL=jinaai/jina-embeddings-v2-base-en
# NRC_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# NRC_ENABLE_RERANKER=true
# NRC_TOP_K_FINAL=10
# NRC_MAX_FIGURES=4
# NRC_FUZZY_THRESHOLD=0.92
# NRC_ENABLE_SUPPORT_CHECK=true
# NRC_LLM_TIMEOUT=180
